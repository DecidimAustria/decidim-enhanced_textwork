<% routes = Decidim::EngineRouter.main_proxy(current_component) %>
<% support = current_user && target.supports.find_by(author: current_user) %>
<% url = resource.is_a?(Decidim::EnhancedTextwork::Section) ? routes.section_support_path(resource) : routes.amendment_support_path(resource) %>
<span><%= t("decidim.enhanced_textwork.texts.support_count", count: target.supports.count) %></span>
<% if current_settings.supports_enabled? && !current_settings.supports_blocked? %>
  <% if current_user %>
    <% if Decidim::EnhancedTextwork::Access.allowed?(current_user, resource, :support) && (support || (resource.is_a?(Decidim::EnhancedTextwork::Section) ? target.id == resource.current_revision_id : resource.state == "pending")) %>
      <%= button_to t("decidim.enhanced_textwork.texts.#{support ? 'unsupport' : 'support'}"), url, method: support ? :delete : :post, params: { revision_id: target.id }, class: "button button__sm button__secondary" %>
    <% end %>
  <% else %>
    <%= link_to t("decidim.enhanced_textwork.texts.sign_in"), decidim.new_user_session_path, class: "textwork__action-link" %>
  <% end %>
<% end %>
