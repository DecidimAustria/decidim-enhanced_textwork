<div class="item_show__header">
  <h1 class="item_show__header-title"><%= t("decidim.enhanced_textwork.admin.title") %></h1>
  <%= link_to t("decidim.enhanced_textwork.admin.export"), export_textwork_path, class: "button button__sm button__secondary" %>
</div>
<div class="item__edit item__edit-1col"><div class="item__edit-form">
<% unless @document %>
  <%= decidim_form_for(@form, url: import_textwork_path, html: { class: "form-defaults" }) do |form| %>
    <div class="form__wrapper">
      <p><%= t("decidim.enhanced_textwork.admin.import_help") %></p>
      <%= form.translated :text_field, :title %>
      <%= form.translated :text_area, :description %>
      <%= form.editor :content, required: false %>
      <%= form.file_field :document, accept: ".md,.markdown,.odt", label: t("decidim.enhanced_textwork.admin.document_file") %>
    </div>
    <%= form.submit t("decidim.enhanced_textwork.admin.import"), class: "button button__sm button__secondary" %>
  <% end %>
<% else %>
  <h2><%= translated_attribute(@document.title) %></h2>
  <% unless @document.published? %>
    <%= button_to t("decidim.enhanced_textwork.admin.publish"), publish_textwork_path, method: :patch, class: "button button__sm button__secondary" %>
  <% else %>
    <%= link_to t("decidim.enhanced_textwork.admin.preview"), Decidim::EngineRouter.main_proxy(current_component).textwork_path %>
  <% end %>
  <ol><% @drafts.each do |section| %>
    <li>
      <h3><%= translated_attribute(section.title) %></h3>
      <div class="editor-content"><%= decidim_sanitize_editor(translated_attribute(section.body)) %></div>
      <%= link_to t("decidim.enhanced_textwork.admin.edit"), edit_section_path(section) %>
      <%= button_to t("decidim.enhanced_textwork.admin.up"), move_section_path(section, direction: :up), method: :patch %>
      <%= button_to t("decidim.enhanced_textwork.admin.down"), move_section_path(section, direction: :down), method: :patch %>
      <% unless @document.published? %><%= button_to t("decidim.enhanced_textwork.admin.delete_draft"), section_path(section), method: :delete %><% end %>
    </li>
  <% end %></ol>
<% end %>
</div></div>
