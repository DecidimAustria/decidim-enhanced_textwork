<% append_stylesheet_pack_tag "decidim_enhanced_textwork" %>
<div class="textwork-page">
  <h1 class="title-decorator"><%= t("decidim.enhanced_textwork.texts.amend") %></h1>
  <% if @amendment.errors.any? %><p role="alert"><%= @amendment.errors.full_messages.to_sentence %></p><% end %>
  <%= decidim_form_for @form, url: section_amendments_path(@section), html: { class: "form-defaults" } do |form| %>
    <%= form.hidden_field :base_revision_id %>
    <%= form.text_field :title, label: t("activemodel.attributes.import_form.title") %>
    <%= form.editor :body, label: t("decidim.enhanced_textwork.texts.proposed_text") %>
    <%= form.text_area :reason, label: t("decidim.enhanced_textwork.texts.reason"), rows: 3 %>
    <%= form.submit t("decidim.enhanced_textwork.texts.submit_amendment"), class: "button button__sm button__secondary" %>
  <% end %>
</div>
