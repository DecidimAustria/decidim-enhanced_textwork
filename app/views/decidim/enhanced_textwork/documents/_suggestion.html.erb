<section class="tw-suggestion <%= 'tw-suggestion--closed' unless suggestion.pending? %>" data-suggestion="<%= suggestion.id %>" aria-labelledby="tw-suggestion-<%= suggestion.id %>">
  <%= render "suggestion_meta", suggestion: %>
  <h3 id="tw-suggestion-<%= suggestion.id %>"><button type="button" class="tw-text-button" data-open-block="<%= @block.id %>" data-mode="suggestions" data-suggestion-id="<%= suggestion.id %>"><%= tw("by", name: suggestion.author.name) %></button></h3>
  <%= render "suggestion_diff", suggestion:, compact: true %>
  <% if suggestion.outdated? %><p class="tw-outdated"><%= tw("outdated") %></p><% end %>
  <% if suggestion.original(:answer).present? %><p class="tw-muted"><strong><%= tw("decision_reason") %>:</strong> <%= textwork_plain(suggestion, :answer) %></p><% end %>
  <%= render "suggestion_actions", suggestion: %>
  <div class="tw-card-actions">
    <%= render "interactions", resource: suggestion, follow: false %>
    <% if suggestion.pending? %>
      <button type="button" class="tw-text-button tw-desktop" data-action="textwork#preview" data-preview-id="<%= suggestion.id %>" aria-pressed="false"><%= tw("show_in_text") %></button>
      <span class="tw-marked tw-desktop" data-marked-id="<%= suggestion.id %>" hidden><%= tw("marked_in_text") %></span>
    <% end %>
    <button type="button" class="tw-text-button tw-mobile" data-open-block="<%= @block.id %>" data-mode="suggestions" data-suggestion-id="<%= suggestion.id %>"><%= tw("details") %></button>
  </div>
</section>
