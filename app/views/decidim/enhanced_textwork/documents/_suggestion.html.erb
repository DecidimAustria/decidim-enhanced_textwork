<article class="tw-suggestion" data-suggestion="<%= suggestion.id %>" <%= 'hidden data-extra-suggestion' if extra %>>
  <header class="tw-card-header"><span class="tw-avatar" aria-hidden="true"><%= suggestion.author&.name.to_s.first %></span><span><strong><%= suggestion.author&.name %></strong> · <time datetime="<%= suggestion.created_at.iso8601 %>"><%= l(suggestion.created_at.to_date) %></time></span><% if suggestion.authored_by?(current_user) %><span class="tw-own"><%= tw('suggestions.own') %></span><% end %></header>
  <%= render 'suggestion_diff', suggestion:, compact: true %>
  <% if suggestion.original(:justification).present? %><div class="tw-justification"><strong><%= tw('suggestions.justification') %></strong> <%= textwork_reading(suggestion, :justification) %></div><% end %>
  <footer class="tw-card-actions"><%= render 'interactions', resource: suggestion %><div class="tw-own-actions"><%= render 'suggestion_actions', suggestion: %><button type="button" class="tw-text-button" data-open-block="<%= @block.id %>" data-suggestion-id="<%= suggestion.id %>"><%= tw('suggestions.comments_link', count: suggestion.comments_count) %></button></div></footer>
</article>
