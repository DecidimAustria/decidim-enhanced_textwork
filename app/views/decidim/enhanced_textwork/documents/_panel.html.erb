<div class="tw-panel-content" data-panel-block="<%= @block.id %>" data-panel-mode="<%= @mode %>" data-panel-number="<%= textwork_number(@block) %>" data-comment-total="<%= @block.comments_count %>" data-suggestion-total="<%= @suggestions.size %>">
  <header class="tw-panel-header">
    <div class="tw-panel-title"><h2 tabindex="-1" data-panel-title><%= tw('panel.title', number: textwork_number(@block)) %></h2><button type="button" class="tw-icon" data-action="textwork#close" aria-label="<%= tw('panel.close') %>"><%= icon 'close-line' %></button></div>
    <p class="tw-panel-excerpt"><%= textwork_excerpt(@block) %></p>
    <% if @mode == 'list' %><div class="tw-panel-actions">
      <% if textwork_open?(:likes) %><%= render 'interactions', resource: @block, panel: true %><% end %>
      <% if textwork_open?(:suggestions) %><button type="button" class="tw-action" data-open-block="<%= @block.id %>" data-mode="edit"><%= icon 'pencil-line' %><span><%= tw('panel.suggest') %></span></button><% end %>
      <% if textwork_open?(:comments) %><button type="button" class="tw-action" data-action="textwork#focusComment"><%= icon 'chat-1-line' %><span><%= tw('panel.comment') %></span></button><% end %>
    </div><% end %>
  </header>
  <div class="tw-panel-body">
    <p class="tw-notice" data-notice role="status" aria-live="polite" hidden></p>
    <% if @mode == 'edit' %><%= render 'editor' %>
    <% elsif @mode == 'detail' %><%= render 'suggestion_detail' %>
    <% else %>
      <blockquote class="tw-mobile-quote"><%= textwork_reading(@block) %></blockquote>
      <h3 class="tw-suggestions-title"><%= tw('suggestions.title', count: @suggestions.size) %></h3>
      <% if @suggestions.empty? %><p class="tw-muted"><%= tw('suggestions.empty') %></p><% end %>
      <div class="tw-suggestions"><% @suggestions.each_with_index do |suggestion, index| %><%= render 'suggestion', suggestion:, extra: index >= 3 %><% end %></div>
      <% if @suggestions.size > 3 %><button type="button" class="tw-text-button tw-show-all" data-action="textwork#showAll"><%= tw('suggestions.show_all', count: @suggestions.size) %></button><% end %>
      <section class="tw-comments" data-comments-open="<%= textwork_open?(:comments) %>" data-comments-kind="block" data-comments-small="<%= @block.comments_count < 5 %>"><%= inline_comments_for(@block) %></section>
    <% end %>
  </div>
  <% if @mode == 'edit' %><footer class="tw-panel-footer"><button type="button" class="button button__sm button__transparent-secondary" data-open-block="<%= @block.id %>"><%= tw('suggestions.form.cancel') %></button><% if @editor_allowed %><button type="submit" form="tw-suggestion-form" class="button button__sm button__secondary" data-submit disabled><%= tw('suggestions.form.submit') %></button><% end %></footer><% end %>
</div>
