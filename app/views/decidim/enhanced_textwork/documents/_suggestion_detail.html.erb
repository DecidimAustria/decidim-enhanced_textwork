<button type="button" class="tw-text-button tw-back" data-open-block="<%= @block.id %>" data-mode="suggestions"><%= icon "arrow-left-line" %><%= tw("all_suggestions") %></button>
<section class="tw-suggestion-detail" data-suggestion="<%= @suggestion.id %>" aria-labelledby="tw-suggestion-title">
  <%= render "suggestion_meta", suggestion: @suggestion, author: true %>
  <h3 id="tw-suggestion-title"><%= tw("suggestion_title", number: @block.number) %></h3>
  <p class="tw-muted tw-desktop"><%= tw("change_marked") %></p>
  <div class="tw-mobile"><%= render "suggestion_diff", suggestion: @suggestion %></div>
  <% if @suggestion.outdated? %><p class="tw-outdated"><%= tw("outdated") %></p><% end %>
  <% if @suggestion.original(:justification).present? %><div><h4><%= tw("justification") %></h4><%= textwork_reading(@suggestion, :justification) %></div><% end %>
  <% if @suggestion.original(:answer).present? %><div><h4><%= tw("decision_reason") %></h4><%= textwork_reading(@suggestion, :answer) %></div><% end %>
  <%= render "suggestion_actions", suggestion: @suggestion %>
  <div class="tw-card-actions">
    <%= render "interactions", resource: @suggestion, follow: false %>
    <%= cell "decidim/report_button", @suggestion, modal_id: "tw-report-#{@suggestion.id}" %>
  </div>
</section>
<section class="tw-suggestion-comments" aria-label="<%= tw('suggestion_comments') %>">
  <h3><%= tw("suggestion_comments") %></h3>
  <%= inline_comments_for(@suggestion) %>
</section>
