<button type="button" class="tw-text-button tw-back" data-open-block="<%= @block.id %>"><%= tw('suggestions.show.back', number: textwork_number(@block)) %></button>
<section class="tw-suggestion-detail" data-suggestion="<%= @suggestion.id %>">
  <h3><%= tw('suggestions.show.title', author: @suggestion.author&.name) %></h3><time class="tw-muted" datetime="<%= @suggestion.created_at.iso8601 %>"><%= l(@suggestion.created_at.to_date) %></time>
  <%= render 'suggestion_diff', suggestion: @suggestion, compact: false %>
  <% if @suggestion.original(:justification).present? %><div class="tw-justification"><strong><%= tw('suggestions.justification') %></strong> <%= textwork_reading(@suggestion, :justification) %></div><% end %>
  <div class="tw-card-actions"><%= render 'interactions', resource: @suggestion %><div class="tw-own-actions"><%= render 'suggestion_actions', suggestion: @suggestion %></div><%= cell 'decidim/report_button', @suggestion, modal_id: "tw-report-#{@suggestion.id}" %></div>
</section>
<section class="tw-comments" data-comments-open="<%= textwork_open?(:comments) %>" data-comments-kind="suggestion" data-comments-small="<%= @suggestion.comments_count < 5 %>"><%= inline_comments_for(@suggestion) %></section>
