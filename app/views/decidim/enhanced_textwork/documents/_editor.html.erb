<% @editor_allowed = Decidim::EnhancedTextwork::Access.allowed?(current_user, @block, :suggest) %>
<% editor_text = @suggestion&.original || @block.original %>
<div class="tw-editor-intro">
  <h3 class="tw-editor-title"><%= tw(@suggestion ? 'suggestions.form.title_edit' : 'suggestions.form.title') %></h3>
  <p class="tw-muted"><%= tw('suggestions.form.original_language_hint', language: @document.locale) %></p>
</div>
<% unless @editor_allowed %><%= action_authorized_link_to :suggest, tw('panel.suggest'), document_path(@document, block: @block.id), resource: @block, class: 'button button__sm button__secondary' %>
<% else %>
<%= form_with url: (@suggestion ? block_suggestion_path(@block, @suggestion) : block_suggestions_path(@block)), method: @suggestion ? :patch : :post, id: 'tw-suggestion-form', class: 'tw-suggestion-form', data: { action: 'submit->textwork#submit input->textwork#changed', suggestion_form: true } do %>
  <%= hidden_field_tag :expected_version, @block.current_version_number %>
  <div class="tw-editor" data-editor data-original="<%= @block.original %>">
    <div class="tw-form-field">
      <%= label_tag :tw_body, tw('suggestions.form.text_label', number: textwork_number(@block)) %>
      <%= text_area_tag :body, editor_text, id: 'tw_body', rows: editor_text.include?("\n") ? 5 : 4, maxlength: 5000, required: true %>
      <% if @block.original.match?(/^\s*(?:[-*]|\d+\.)\s+/) %><p class="tw-muted"><%= tw('suggestions.form.list_hint') %></p><% end %>
    </div>
    <div class="tw-editor-preview">
      <h4><%= tw('suggestions.form.preview_title') %></h4>
      <div class="tw-diff" data-live-diff role="status" aria-live="polite" aria-atomic="true"></div>
    </div>
  </div>
  <div class="tw-form-field">
    <%= label_tag :tw_justification do %><%= tw('suggestions.form.justification_label') %> <span class="tw-muted tw-field-optional"><%= tw('suggestions.form.optional') %></span><% end %>
    <%= text_area_tag :justification, @suggestion&.original(:justification), id: 'tw_justification', maxlength: 1000, rows: 2 %>
  </div>
  <p data-form-error role="alert"></p>
<% end %>
<% end %>
