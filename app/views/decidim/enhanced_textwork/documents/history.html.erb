<main class="container py-12"><h1 class="title-decorator"><%= tw("document_history") %></h1><%= link_to tw("back"), document_path(@document) %><ol class="my-8 space-y-8"><% @history.each do |entry| %><li><h2><%= l(entry.created_at) %> · <%= entry.author&.name %></h2><p><%= tw("history_#{entry.is_a?(Decidim::EnhancedTextwork::BlockVersion) ? entry.origin : entry.kind}") %> · <%= entry.block&.number || tw("removed") %></p><% if entry.respond_to?(:body) %><div class="editor-content"><%= Decidim::EnhancedTextwork::Markdown.render(entry.body) %></div><% else %><p><%= entry.details['body'] %></p><p><%= entry.note %></p><% end %><%= link_to tw("versions"), block_versions_path(entry.block) if entry.block %></li><% end %></ol></main>
