<% if suggestion.withdrawable_by?(current_user) || suggestion.editable_by?(current_user) %>
  <div class="tw-own-actions">
    <% if suggestion.withdrawable_by?(current_user) %><button type="button" class="tw-text-button" data-action="textwork#withdraw" data-url="<%= withdraw_suggestion_path(suggestion) %>"><%= tw("withdraw") %></button><% end %>
    <% if suggestion.editable_by?(current_user) %><button type="button" class="tw-text-button" data-open-block="<%= @block.id %>" data-mode="edit" data-suggestion-id="<%= suggestion.id %>"><%= tw("edit") %></button><% end %>
  </div>
<% end %>
