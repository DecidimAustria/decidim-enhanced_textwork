<% if suggestion.editable_by?(current_user) %><button type="button" class="tw-text-button" data-open-block="<%= @block.id %>" data-mode="edit" data-suggestion-id="<%= suggestion.id %>"><%= tw('suggestions.edit') %></button><% end %>
<% if suggestion.withdrawable_by?(current_user) %><button type="button" class="tw-text-button" data-action="textwork#withdraw" data-url="<%= withdraw_suggestion_path(suggestion) %>"><%= tw('suggestions.withdraw') %></button><% end %>
